PORT=8080
OSGB_MEMORY_LIMIT=12g
OSGB_SHM_SIZE=1g
DATA_DIR=./runtime
CONFIG_FILE=./runtime/service.env
PIPELINE_MODE=native

# Standard open-source photogrammetry chain.
COLMAP_BIN=colmap
OPENMVS_INTERFACE_BIN=InterfaceCOLMAP
OPENMVS_DENSIFY_BIN=DensifyPointCloud
OPENMVS_RECONSTRUCT_BIN=ReconstructMesh
OPENMVS_REFINE_BIN=RefineMesh
OPENMVS_TEXTURE_BIN=TextureMesh
# CPU-only dense reconstruction. Do not add --cuda-device in the CPU deployment.
# --max-threads is filled in automatically from PIPELINE_THREADS; it is omitted
# here so that changing PIPELINE_THREADS actually takes effect.
OPENMVS_DENSIFY_ARGS="{scene_mvs} -o {dense_mvs} --resolution-level 2 --max-resolution 1600 --number-views 4 --sub-resolution-levels 0 --fusion-mode 0"
OSGCONV_BIN=osgconv

# ---- Compute configuration (CPU-only deployment) ----------------------------
# The service never uses a GPU: GPU switches are forced off for COLMAP and
# OpenMVS, and CUDA_VISIBLE_DEVICES is cleared for every subprocess. All stages
# therefore run on the CPU, which is why the thread count below is the main
# performance lever.
#
# Worker count for COLMAP and OpenMVS. 0 (the default) means "auto": one thread
# per available CPU minus one, capped at 16. Set an explicit value to override.
PIPELINE_THREADS=0

# Feature matching strategy. This dominates total runtime.
#   sequential  - match each image against its N neighbours in filename order.
#                 Correct for aerial surveys, which are captured along flight
#                 lines. For 428 images this is ~4,300 pairs instead of ~91,000.
#   exhaustive  - match every image against every other image (O(n^2)). Most
#                 thorough and slowest; correct for unordered image sets.
#   vocab_tree  - needs a vocabulary tree file; useful for very large sets.
#   spatial     - uses prior camera positions; needs a spatial reconstruction.
COLMAP_MATCHER=sequential
# Neighbour count per image for the sequential matcher. Raise it if adjacent
# flight lines fail to connect during SfM; 10 is a good default for nadir imagery.
COLMAP_MATCHER_OVERLAP=10

# Long edge fed to SIFT feature extraction. Lower is faster but finds fewer
# features. 3200 suits ~20 MP drone imagery.
SIFT_MAX_IMAGE_SIZE=3200

# Optional coordinate transform and pre-LOD stages.
# The service always emits a Smart3D-style PagedLOD OSGB tree after texture mapping.
GEOREF_BIN=
GEOREF_ARGS="{model_path} {job_dir}"
LOD_BIN=
LOD_ARGS="{model_path} {job_dir}"

# Optional compatibility mode for an existing ODX/ODM-style workflow.
RECON_BIN=
RECON_ARGS="{project_dir} --skip-orthophoto --skip-report"
OSGB_BIN=
OSGB_ARGS="{obj_path} {output_path}"

# Optional: restrict output paths to this directory.
OUTPUT_ROOT=
COMMAND_TIMEOUT_HOURS=24
MAX_UPLOAD_GB=50
